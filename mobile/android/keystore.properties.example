# Copy to `keystore.properties` (git-ignored) on the publishing machine only.
#
# With this file absent, `./gradlew assembleRelease` still works and produces an UNSIGNED APK — useful for
# exercising R8 and the resource shrinker, not installable on a phone. With it present, `assembleRelease` and
# `bundleRelease` are signed with the upload key and need no command-line arguments.
#
# Generate the key once:
#   keytool -genkeypair -v -keystore clinic-upload.jks -keyalg RSA -keysize 4096 \
#           -validity 10000 -alias clinic-upload
#
# ⚠️ Back the .jks up in two places that are NOT this machine. Under Play App Signing, losing the upload key ends
#    this listing's ability to be updated. The passwords are not recoverable either.
#
# ⚠️ Use forward slashes in storeFile: a Java properties file reads `\` as an escape character.

storeFile=C:/absolute/path/to/clinic-upload.jks
storePassword=
keyAlias=clinic-upload
keyPassword=
