<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      `confirmIdentity` (AC-57). A **normal** permission, granted at install with no runtime prompt — unlike
      CAMERA above, which is deliberately absent. `USE_BIOMETRIC` supersedes `USE_FINGERPRINT` at API 28, which
      is also the floor `BiometricGate` asks below, so the deprecated one buys nothing.
    -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!--
      The in-app update (`ShellUpdater`, android-in-app-update): handing a downloaded APK to Android's installer.
      Granted per app by the user (« Installer des applis inconnues »), which Android asks for on the first update.
      ⚠️ Google Play restricts this permission; it is here because this build is sideloaded, and a Play build
      would update through the store and must drop it.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      `relayProbe` (clinic-pc-copy AC-6.2): this phone's default gateway, which the cloud compares with the PC de
      secours's to know the phone is on the cabinet's network. A **normal** permission — no runtime prompt.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      Phone notifications (staff-chat Part 7). A RUNTIME permission from Android 13: the app asks once, when the
      signed-in page first wants a token, and « Activer les notifications » in « Messages » asks again or opens the
      settings.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Without this, `resolveActivity` for ACTION_IMAGE_CAPTURE returns null on API 30+ (package visibility) and
      the camera would silently disappear from the file chooser (AC-18). There is deliberately NO
      `android.permission.CAMERA`: declaring it would oblige us to request it at runtime, while the camera app
      handles its own permission when it is launched by intent.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClinicShell">

        <!--
          singleTop: a notification tap reaches the running activity through onNewIntent instead of FCM's
          CLEAR_TOP recreating it — which would drop the WebView and whatever was typed in an open form.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|density|fontScale|uiMode|keyboard|keyboardHidden|navigation|touchscreen|layoutDirection">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Delivers a file written by `ShellBridge.saveFile` to a viewer or a share target. `exported="false"` +
          per-Intent grants is the only supported way to hand an app-private file out — a `file://` Uri throws
          FileUriExposedException from API 24 on.
        -->
        <service
            android:name=".ShellMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- What Android draws a server-sent banner with: the chevron in white, and the agenda channel by default. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_notify" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/brand_primary" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="agenda" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
