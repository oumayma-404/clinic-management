# Node / Next.js
node_modules/
.next/
out/

# .NET build output
[Bb]in/
[Oo]bj/

# .NET / Rider / VS
*.user
.vs/

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Local (offline) mode per-install secrets — generated at first run, never committed
# (.local/ covers the signing key, cert password, generated ca.crt / server.pfx — FR-F4)
.local/
**/signing-key

# Packaging build artifacts (Phase 5) — keep the committed .iss/.ps1 scripts, ignore build output
packaging/**/build-output/
packaging/build-output/
# Operator-supplied third-party binaries staged for the installers (not committed)
packaging/server/tools/
# Build-time tools fetched by fetch-build-tools.ps1 (PostgreSQL binaries, NSSM) — not committed
packaging/build-tools/
