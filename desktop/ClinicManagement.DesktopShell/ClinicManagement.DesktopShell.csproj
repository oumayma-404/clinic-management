<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--
      WPF + WebView2 → Windows-only desktop target (distinct from the backend's net8.0).

      ⚠️ **The `10.0.19041.0` suffix is what makes the Windows Runtime reachable**, and it is the whole reason the
      shell can offer Windows Hello: `Windows.Security.Credentials.UI.UserConsentVerifier` lives in the WinRT
      projection, which a bare `net8.0-windows` does not reference. Without it `confirmIdentity` cannot be
      implemented at all and the inactivity limit stays a full sign-out on the one device where locking is safest.

      ⚠️ **`SupportedOSPlatformVersion` is deliberately LOWER than the target.** The target says which APIs the
      compiler knows about; this says the oldest Windows the binary may run on. Leaving them equal would refuse to
      install on Windows 10 1809–1903 machines that a cabinet may well still have, for the sake of APIs this shell
      does not call. Hello itself is present from 1809, and every call is guarded so a machine without it answers
      « unavailable » rather than failing.

      Neither value appears in any build path — `packaging/publish-server.ps1` and `client-installer.yml` both use
      an explicit `-o`, so changing the target framework moves nothing they look for.
    -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ClinicManagement.DesktopShell</RootNamespace>
    <AssemblyName>ClinicManagement.DesktopShell</AssemblyName>
    <!-- 1.2.0 with clinic-file-vault: this shell now exposes window.__clinicShell (its first bridge), and
         mobile/shared/bridge.md's rule is that the method set and the version move together. It is also what
         `version` reports to the page and what X-Client-Version already sent, so there is one number.

         1.3.0 adds `confirmIdentity` (Windows Hello), so the inactivity limit LOCKS this shell instead of
         signing it out.

         ⚠️ Bumping this must NOT be accompanied by raising the server's minimum-client-version floor. The floor
         is what `ClientVersionMiddleware` answers 426 on, and every clinic PC that has not yet self-updated
         would be refused on every route — for a feature whose whole point is that its absence is harmless
         (the web bundle feature-detects the method and signs out exactly as before). Velopack delivers 1.3
         silently; nothing has to be forced. -->
    <Version>1.3.0</Version>
    <!-- Shown in the title bar, the taskbar, alt-tab and Explorer, and picked up by the client installer as its
         own icon. Generated from `web/branding/icon.svg` by `web/scripts/generate-icons.mjs` — never hand-edited,
         or the shell's tile drifts from the browser tab it renders. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The Windows file-properties strings. Without these the .exe reports its assembly name
         ("ClinicManagement.DesktopShell") wherever Windows shows a product name — the installed-apps list, the
         UAC prompt, SmartScreen. -->
    <Product>APEXA</Product>
    <AssemblyTitle>APEXA</AssemblyTitle>
    <Company>APEXA</Company>
    <Description>Client de bureau pour le serveur du cabinet.</Description>
    <!-- Self-contained win-x64 publish is driven by packaging/publish-server.ps1 (S6); no RID pinned here
         so `dotnet build` stays framework-dependent for review. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Evergreen WebView2 control (managed wrapper + loader; the runtime is installed on the client PC). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
