<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- WPF + WebView2 → Windows-only desktop target (distinct from the backend's net8.0). -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>ClinicManagement.DesktopShell</RootNamespace>
    <AssemblyName>ClinicManagement.DesktopShell</AssemblyName>
    <!-- 1.2.0 with clinic-file-vault: this shell now exposes window.__clinicShell (its first bridge), and
         mobile/shared/bridge.md's rule is that the method set and the version move together. It is also what
         `version` reports to the page and what X-Client-Version already sent, so there is one number. -->
    <Version>1.2.0</Version>
    <!-- Shown in the title bar, the taskbar, alt-tab and Explorer, and picked up by the client installer as its
         own icon. Generated from `web/branding/icon.svg` by `web/scripts/generate-icons.mjs` — never hand-edited,
         or the shell's tile drifts from the browser tab it renders. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- The Windows file-properties strings. Without these the .exe reports its assembly name
         ("ClinicManagement.DesktopShell") wherever Windows shows a product name — the installed-apps list, the
         UAC prompt, SmartScreen. -->
    <Product>APEXA</Product>
    <AssemblyTitle>APEXA</AssemblyTitle>
    <Company>APEXA</Company>
    <Description>Client de bureau pour le serveur du cabinet.</Description>
    <!-- Self-contained win-x64 publish is driven by packaging/publish-server.ps1 (S6); no RID pinned here
         so `dotnet build` stays framework-dependent for review. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Evergreen WebView2 control (managed wrapper + loader; the runtime is installed on the client PC). -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

</Project>
