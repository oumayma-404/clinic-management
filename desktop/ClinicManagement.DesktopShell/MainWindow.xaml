<Window x:Class="ClinicManagement.DesktopShell.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Clinic Management" Height="820" Width="1280"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Serveur">
                <MenuItem x:Name="ChangeServerMenuItem" Header="_Changer de serveur…" Click="ChangeServer_Click"/>
                <Separator/>
                <MenuItem x:Name="ReloadMenuItem" Header="_Recharger" Click="Reload_Click"/>
            </MenuItem>
        </Menu>

        <Grid>
            <!-- The hosted clinic app. Hidden until a navigation succeeds so a failed load never
                 shows a raw browser error page (AC-2.4). -->
            <wv2:WebView2 x:Name="WebView"
                          Visibility="Collapsed"
                          NavigationCompleted="WebView_NavigationCompleted"/>

            <!-- Shown while the initial page is loading so a failed load never flashes the raw
                 browser error page before our friendly screen (AC-2.4). -->
            <Grid x:Name="ConnectingPanel" Background="#FFF4F6F8" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Connexion au serveur de la clinique…"
                               FontSize="16" Foreground="#FF52606D" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ConnectingTarget"
                               FontSize="12" Foreground="#FF7B8794" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- Server-address entry: first run (AC-2.2) and "change server" (AC-2.3). -->
            <Grid x:Name="ServerConfigPanel" Background="#FFF4F6F8" Visibility="Collapsed">
                <Border Width="480" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Background="White" CornerRadius="10" Padding="32" BorderBrush="#FFE0E4E8" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Clinic Management" FontSize="22" FontWeight="SemiBold" Foreground="#FF1F2933"/>
                        <TextBlock Text="Adresse du serveur de la clinique"
                                   FontSize="14" Foreground="#FF52606D" Margin="0,4,0,20" TextWrapping="Wrap"/>
                        <TextBlock Text="Saisissez l'adresse IP ou le nom du serveur (par ex. 192.168.1.10 ou clinic-server). Sur le PC serveur, utilisez « localhost »."
                                   FontSize="12" Foreground="#FF7B8794" Margin="0,0,0,12" TextWrapping="Wrap"/>
                        <TextBox x:Name="ServerAddressTextBox"
                                 FontSize="16" Padding="10,8" BorderBrush="#FFCBD2D9" BorderThickness="1"
                                 KeyDown="ServerAddressTextBox_KeyDown"/>
                        <TextBlock x:Name="ServerConfigError"
                                   Foreground="#FFC0392B" FontSize="12" Margin="0,8,0,0"
                                   Visibility="Collapsed" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <Button x:Name="ServerConfigCancelButton" Content="Annuler"
                                    Padding="16,8" Margin="0,0,10,0" Click="ServerConfigCancel_Click"/>
                            <Button x:Name="ServerConfigSaveButton" Content="Se connecter"
                                    Padding="16,8" Background="#FF2D7FF9" Foreground="White" BorderThickness="0"
                                    Click="ServerConfigSave_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Friendly, recoverable "cannot reach server" screen — never a blank page or raw
                 browser error (AC-2.4). -->
            <Grid x:Name="UnreachablePanel" Background="#FFF4F6F8" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
                    <TextBlock Text="⚠" FontSize="48" HorizontalAlignment="Center" Foreground="#FFE67E22" Margin="0,0,0,12"/>
                    <TextBlock Text="Impossible de joindre le serveur de la clinique"
                               FontSize="20" FontWeight="SemiBold" Foreground="#FF1F2933"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="UnreachableDetail"
                               FontSize="13" Foreground="#FF52606D" Margin="0,12,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                        <Button Content="Réessayer" Padding="20,10" Margin="0,0,10,0"
                                Background="#FF2D7FF9" Foreground="White" BorderThickness="0"
                                Click="Retry_Click"/>
                        <Button Content="Changer de serveur" Padding="20,10" Click="ChangeServer_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
