<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ClinicManagement.Domain\ClinicManagement.Domain.csproj" />
    <ProjectReference Include="..\ClinicManagement.Application\ClinicManagement.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.68.0.3536" />
    <PackageReference Include="Google.Apis.Auth" Version="1.68.0" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="8.0.0" />
    <!--
      Lets the Data Protection key ring live in PostgreSQL rather than on a volume, for a host that offers no
      durable disk (Render's free tier, and every PaaS shaped like it). The database is then the only durable
      thing the deployment has, and an ephemeral ring is not a degradation there: on HostedMultiTenant every
      administrator MUST hold a second factor, whose secret this ring encrypts, so a redeploy would lock every
      administrator out of their own cabinet. See LocalDataProtection.PersistToDatabaseKey.
    -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />
    <!-- Transitive pin, not a used dependency: Configuration.Json's graph carried System.Text.Json 8.0.0
         (GHSA-hh2w-p6rv-4g7w, fixed in 8.0.4). Pinned rather than left to the parent so the version is explicit
         and reviewable; remove it if a future parent bump already floats above 8.0.4. -->
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="8.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.1.2" />
    <PackageReference Include="Minio" Version="5.0.0" />
    <!--
      For MinioFileStorage.DownloadAsync. The MinIO SDK is push-based (it hands you a stream inside a callback
      and closes it when the callback returns), so turning it into a stream a caller can pull from needs a
      producer/consumer pipe — the alternative was buffering every download whole in memory, which is what this
      replaced. `System.IO.Pipelines` is in the ASP.NET shared framework but NOT in Microsoft.NETCore.App, so a
      plain class library has to name it.
      ⚠️ Not System.IO.Pipes: an OS pipe closes as EOF when the producer fails, so a mid-transfer MinIO error
      would arrive as a SILENT TRUNCATION. A PipeWriter completed with an exception makes the reader throw.
    -->
    <PackageReference Include="System.IO.Pipelines" Version="8.0.0" />
    <!-- 8.0.11 pulls Npgsql 8.0.x, clearing GHSA-x9vc-6hfv-hg8c. Deliberately NOT 9.0.x: EF Core 9 is a major
         upgrade on a schema with 100+ migrations, not a security patch. -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <!-- RFC 6238 one-time codes for the console's second factor (platform-console FR-1). Used only by
         Auth/TotpService, so Domain keeps its zero package references. -->
    <PackageReference Include="Otp.NET" Version="1.4.1" />
    <PackageReference Include="PdfSharp" Version="6.1.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <PackageReference Include="QuestPDF" Version="2024.10.0" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="8.0.4" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official CNAM BS1 form, stamped at runtime by the bulletin-cnam overlay renderer. -->
    <Content Include="Assets\BS1.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Official CNAM P 061 form (« certificat médical d'arrêt de travail »), stamped by the L11 overlay renderer.
         A NORMALISED copy of features/cnam-arret-travail-overlay/assets/P61_2024.pdf: the bundled scan is an A4
         portrait page whose form content runs sideways, and this one has the rotation baked into the content stream
         as A4 landscape — so every coordinate in the renderer matches what a ruler on the printout measures. -->
    <Content Include="Assets\P61.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
