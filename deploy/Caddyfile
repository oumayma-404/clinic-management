# Single-domain reverse proxy with automatic Let's Encrypt TLS (AC-2).
# TLS terminates here once; upstreams speak plain HTTP on the internal Docker network.
#
#   /api/*  -> api:5000   (the .NET API — controller routes live under /api/...)
#   /hub/*  -> api:5000   (SignalR, mapped at the HOST root — not under /api)
#   /health -> api:5000   (liveness, also at the host root — not under /api)
#   /*      -> web:3000   (the Next.js frontend; also serves /auth/* and /bff/* + /_next/*)
#
# Shared by both hosted profiles (docker-compose.prod.yml = CloudBrowser,
# docker-compose.hosted.yml = HostedMultiTenant).
#
# DOMAIN and ACME_EMAIL are injected from the environment by docker-compose.
#
# ⚠️ There WAS a `LEGACY_DOMAIN` here, a second address so the site kept answering to the old OVH hostname
# (`vps-dc7e4229.vps.ovh.net`) through the move to app.apexa.tn. It is gone because the installed client has
# been repointed and `ServerConfig.HostedHost` now names this domain — but the reason it existed is worth
# keeping, because the next rename needs it again:
#
#   The desktop shell pins its host at COMPILE time and an installed client never re-reads that constant. So a
#   rename that drops the old name in the same breath strands every client already in a cabinet, and it strands
#   them somewhere they cannot be reached from: the update feed is fetched from whichever server the client is
#   connected to (`ShellUpdater.CheckAndStageAsync`), so the dead host is also the only route to the build that
#   would fix it. The failure reads as « the product is down », not as « the address changed ».
#
#   The order is therefore: add the new name as a second address here, ship a client naming it, wait for the
#   installed base to take the update, and only then remove the old one. That is what happened; this is the
#   last step of it.
#
# ⚠️ And if a second name is ever needed again, it must be a SEPARATE variable rather than a comma-list inside
# DOMAIN: docker-compose builds `FrontendUrl` and `GoogleCalendar__RedirectUri` out of DOMAIN, and a comma-list
# there would produce a redirect URI Google can never match. DOMAIN is the ONE canonical name.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# HSTS is set HERE, at the site level, so it covers /api/*, /hub/*, /health AND the pages — the API can only
	# ever cover what Kestrel serves, which behind this proxy is /api/* alone.
	#
	# ⚠️ This comment used to say « nothing in the solution consumes X-Forwarded-Proto », and since
	# hosted-security-hardening Part 2 that is no longer true: the API registers `UseForwardedHeaders` bounded by
	# `Security:TrustedProxies`, so `Request.IsHttps` is now TRUE for a proxied request — which is what gives the
	# Google OAuth state cookie its `Secure` flag.
	#
	# ⚠️ That nearly produced TWO of this header. `header` does NOT replace what an upstream sent: reproducing
	# this exact directive over an upstream emitting its own gave the client both, and RFC 6797 § 8.1 then has the
	# browser honour only the first — not a downgrade, but a malformed response carrying a value nothing in the
	# deployment could predict. The fix is in the API, not here: `SecurityHeadersMiddleware` now emits HSTS only
	# where it is itself the edge (`SelfHostsFrontDoor`), which keeps this file's own rule — « HSTS belongs HERE »
	# — true in ONE place rather than by stripping the duplicate on every proxied route. So this is the only
	# emitter, and `includeSubDomains` below is what a client actually receives.
	#
	# ⚠️ The two loopback-only gates did NOT become header-decidable: the API captures the real TCP peer before
	# honouring these headers (`OriginalPeer`), so `setup` and `/hangfire` still refuse a forged
	# `X-Forwarded-For: 127.0.0.1`.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# API — same-origin front door for the frontend's relative `/api` calls (AC-3).
	handle /api/* {
		reverse_proxy api:5000 {
			# ⚠️ **This is what makes a redeploy invisible, and it is the whole reason it is here.** A deploy
			# STOPS the single `clinic-api-prod` container before starting the new one — `container_name:` pins
			# one instance, so old and new never overlap — and for those seconds Caddy cannot dial the upstream
			# at all. Without a try duration that is an INSTANT 502 for every request in the gap, which is
			# exactly what shipped: 25 s of them on 2026-09-01 at 10:34 Tunis, hitting a real clinic mid-session
			# on /dental-acts — `/api/connectivity`, `/api/notifications/pending-reviews` and eighteen
			# `/hub/clinic/negotiate` attempts, all 502, all while the desk was trying to work.
			#
			# With it, Caddy HOLDS the request and re-dials every 250 ms until the new container answers. The
			# client sees one slow request instead of an error, the session survives, and SignalR renegotiates
			# on its own. 45 s is chosen to cover the worst measured swap (25 s, when the deploy also recreated
			# postgres) with room to spare, and to stay under the SignalR client's ~42 s reconnect budget being
			# spent on failures rather than on waiting.
			#
			# ⚠️ Retrying is SAFE FOR POST here, and that is not an accident of configuration. Caddy re-dials
			# only when it never got a connection — no byte of the request was written — so a `POST /api/visits`
			# cannot be applied twice by this. Do not add `retry_match`: broadening it to responses ALREADY sent
			# upstream is what would make a money write replay.
			#
			# ⚠️ The cost, stated: a genuinely broken deploy now makes requests hang for 45 s instead of failing
			# fast. That is the right trade for a clinic — a held request that succeeds beats an error toast —
			# but it means the deploy's own `/health` gate, not a user's browser, is what must catch a bad ship.
			lb_try_duration 45s
			lb_try_interval 250ms
		}
	}

	# SignalR — the hub is mapped at the host root (`/hub/clinic`), NOT under /api, so without this
	# block it falls through to the catch-all below, reaches the Next container and 404s. The failure is
	# totally silent: the client's `connection.start()` sits behind a bare `catch {}` and the server-side
	# broadcast is swallowed by design, so every clinic simply sees stale screens. Caddy forwards the
	# WebSocket upgrade automatically — this needs no extra directive.
	handle /hub/* {
		reverse_proxy api:5000 {
			# Same reason as the /api/* block above: ride out the container swap instead of 502ing into it.
			lb_try_duration 45s
			lb_try_interval 250ms
		}
	}

	# Liveness. Mapped on the API (never under /api, so it is outside the rate limiter and the client-version
	# floor) — which means without this block it falls through to the catch-all, reaches the Next container and
	# 404s: an endpoint nothing in this topology could reach. Deliberately public: an uptime monitor cannot hold
	# an admin token, and the body carries check names and statuses only, never a reason.
	handle /health {
		# ⚠️ **Deliberately WITHOUT the `lb_try_duration` the two blocks above carry.** Everything else on this
		# site is a clinic's request and is better held than refused; this one is the opposite. /health exists
		# to answer « is the API up, right now », and a route that waits 45 s before admitting the API is down
		# is a route that lies to the deploy's own gate and to any uptime monitor pointed at it. Nobody at a
		# desk ever loads it, so there is nothing here for holding to protect.
		reverse_proxy api:5000
	}

	# Everything else (pages, /_next/*, /auth/* Auth0 routes, /bff/* BFF auth routes).
	handle {
		# The API's SecurityHeadersMiddleware covers only what Kestrel serves, which behind this proxy is
		# /api/* alone — and Next emits its own headers only when AUTH_MODE != local, which is false in
		# HostedMultiTenant. Stating them here is what keeps a page response covered in both hosted
		# profiles. Caddy replaces rather than appends, so a header Next already set is not duplicated.
		#
		# ⚠️ The CSP is the load-bearing addition. Without it page responses carried NO policy at all, which made
		# `Security:EnforceCsp` — the switch US-6 added — have no effect whatsoever on the HTML documents and
		# scripts it exists to constrain: an operator flipping it after a clean page walk would believe the pages
		# were protected when only JSON API responses were. Kept byte-identical to
		# `SecurityHeadersMiddleware.ContentSecurityPolicy`; the two must be changed together.
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy strict-origin-when-cross-origin
			Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()"
			Reporting-Endpoints `csp-endpoint="/api/csp-report"`
			Cross-Origin-Opener-Policy same-origin
			Cross-Origin-Resource-Policy same-site
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'self' blob:; frame-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; report-uri /api/csp-report; report-to csp-endpoint"
		}

		reverse_proxy web:3000 {
			# `web` is recreated by the same deploy as `api`, so a page load lands in the identical gap — and a
			# 502 here is worse than one on /api/*, because it replaces the whole application with Caddy's bare
			# error page rather than a French message inside a screen that is still there.
			lb_try_duration 45s
			lb_try_interval 250ms
		}
	}
}

# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
# THE VENDOR CONSOLE'S PRIVATE SITE (platform-console FR-2).
#
# Bound to 127.0.0.1:9443 and published loopback-only by docker-compose, so it is reachable ONLY over an SSH
# tunnel — it is not on {$DOMAIN}, has no DNS name, and no route reaches it from the public site above.
#
#   /api/platform/*  -> api:5443   (the API's SECOND Kestrel listener — see below)
#   /*               -> console:3000 (the console's own Next application)
#
# ⚠️ THREE THINGS HERE ARE LOAD-BEARING, and each is a way this could look right and be wrong.
#
#   1. `/api/platform/*` goes to **api:5443, never api:5000**. Behind a proxy every request reaches the API from
#      the same container, so `HttpContext.Connection.LocalPort` is the only unforgeable way the process can tell
#      a console request from a public one. Sending it to 5000 would make `ConsolePortGate` 404 it — correctly,
#      because on that port it IS a public request.
#
#   2. The public site above gains **no** `/api/platform` route, and must never gain one. The gate would refuse
#      it anyway, so the damage of adding one is not an open door — it is that the refusal would start looking
#      like a proxy rule, which is exactly the arrangement FR-2 rejects.
#
#   3. `tls internal` — Caddy's own local CA, because 127.0.0.1 has no public name for ACME to issue against.
#      The operator's browser will not know that CA; a certificate warning on a tunnelled loopback address is
#      expected here and is not the same event as one on {$DOMAIN}.
#
#   4. **`console.localhost` is the address an operator opens, and the bare IP alone could not be.** A site
#      addressed ONLY by an IP literal is unreachable from every browser there is: no browser sends SNI for an
#      IP (there is no name to send), Caddy has no site matching an empty ServerName on this port, and it ends
#      the handshake with `internal_error` — which Chrome reports as `ERR_SSL_PROTOCOL_ERROR`, not as a
#      certificate warning somebody could click through. Measured against the hosted VPS, over the tunnel and
#      on the server's own loopback alike:
#
#        openssl s_client -connect 127.0.0.1:9443 -servername 127.0.0.1  → TLSv1.3, TLS_AES_128_GCM_SHA256
#        openssl s_client -connect 127.0.0.1:9443 -noservername          → tlsv1 alert internal error (80)
#
#      Every smoke test this shipped with passes, because `curl` and `wget` both send SNI when given a name and
#      `--no-check-certificate` hides the rest — so « the console is up » was true of everything except the one
#      client it exists for. `*.localhost` resolves to loopback inside Chrome and Firefox with no hosts entry
#      (RFC 6761); Safari and command-line tools need `127.0.0.1 console.localhost` in the hosts file.
#      The IP stays listed so a client that DOES send it as SNI keeps working unchanged.
# ─────────────────────────────────────────────────────────────────────────────────────────────────────────────
https://console.localhost:9443, https://127.0.0.1:9443 {
	tls internal
	encode zstd gzip

	handle /api/platform/* {
		reverse_proxy api:5443 {
			lb_try_duration 45s
			lb_try_interval 250ms
		}
	}

	handle {
		# The console had THREE headers and NO policy at all (hosted-security-hardening FR-4.5). It is a
		# second Next application on a second origin, reached by the account that can read every cabinet in
		# the deployment — so it is the surface where an injected script is worth the most, and it was the
		# one without a policy.
		#
		# Byte-identical to the public site's above and to `SecurityHeadersMiddleware.ContentSecurityPolicy`;
		# `UnitTests/Common/ContentSecurityPolicyAgreementTests` fails the build if the three drift. Identical
		# rather than console-specific because both bundles are Next: the same inline hydration payload, the
		# same `next/font` inline style, the same `blob:` exports.
		#
		# ⚠️ `report-uri /api/csp-report` resolves against THIS site, where `/api/platform/*` is the only
		# proxied API path — so a console violation report reaches Next and 404s rather than reaching the
		# sink. Deliberate, and stated rather than hidden: routing it would mean a second `/api/*` rule here,
		# and the whole point of `ConsolePortGate` is that no proxy rule decides what this port serves. The
		# report is lost; the enforcement, which is what matters, is not.
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options DENY
			Referrer-Policy strict-origin-when-cross-origin
			Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()"
			Cross-Origin-Opener-Policy same-origin
			Cross-Origin-Resource-Policy same-site
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'self' blob:; frame-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; report-uri /api/csp-report; report-to csp-endpoint"
		}

		reverse_proxy console:3000 {
			lb_try_duration 45s
			lb_try_interval 250ms
		}
	}
}
