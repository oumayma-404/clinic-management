# demo.apexa.tn — the public demo cabinet (features/demo-cabinet/). Mounted into Caddy only by
# docker-compose.demo.yml, so production's site set is unchanged without that overlay.
#
# Same routing as the production site, onto the demo containers, plus two things only the demo wants:
#   - search engines do not index it (AC-7.7): `X-Robots-Tag` on every answer and a closed robots.txt;
#   - it offers no install (FR-4): no web app manifest, so no browser « Installer l'application ».
# The Content-Security-Policy below must stay byte-identical to SecurityHeadersMiddleware's (ContentSecurityPolicyAgreementTests).
{$DEMO_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header X-Robots-Tag "noindex, nofollow"

	handle /robots.txt {
		respond "User-agent: *
Disallow: /
" 200
	}
	handle /manifest.webmanifest {
		respond 404
	}
	handle /api/* {
		reverse_proxy api-demo:5000 {
			lb_try_duration 45s
			lb_try_interval 250ms
		}
	}
	handle /hub/* {
		reverse_proxy api-demo:5000 {
			lb_try_duration 45s
			lb_try_interval 250ms
		}
	}
	handle /health {
		reverse_proxy api-demo:5000
	}
	handle {
		header {
			X-Content-Type-Options nosniff
			X-Frame-Options SAMEORIGIN
			Referrer-Policy strict-origin-when-cross-origin
			Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), picture-in-picture=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()"
			Reporting-Endpoints `csp-endpoint="/api/csp-report"`
			Cross-Origin-Opener-Policy same-origin
			Cross-Origin-Resource-Policy same-site
			Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'self' blob:; frame-src 'self' blob:; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; report-uri /api/csp-report; report-to csp-endpoint"
		}
		reverse_proxy web-demo:3000 {
			lb_try_duration 45s
			lb_try_interval 250ms
		}
	}
}
