# Copy to `.env` (same folder) and fill in real values. `.env` is gitignored — never commit it.
# docker-compose reads it automatically:  docker compose -f docker-compose.hosted.yml up -d --build
#
# This is the HOSTED MULTI-TENANT profile (many clinics, one backend, the product's own accounts).
# It is `.env.example` minus every Auth0 value: this deployment does not use Auth0 at all, and a
# half-configured Auth0 block is how the Cloud login path stays quietly reachable.
#
# ⚠️ The keys that decide the profile are NOT here — they are literals in docker-compose.hosted.yml
#    (Deployment__Profile, DataProtection__KeyRingPath, AUTH_MODE, API_INTERNAL_URL,
#    AUTH_COOKIE_SECURE), each with the consequence of omitting it written beside it. They are not
#    operator-tunable: getting any one of them wrong produces a silent failure, and every one of
#    those failures is described in that file rather than left to be discovered.

# ── Domain & TLS ─────────────────────────────────────────────────────────────
# The public domain whose A record points at this VPS. Caddy obtains a Let's Encrypt cert for it;
# ports 80/443 must be open and DNS live before first boot. This is also the single address every
# clinic's desktop client stores — `ServerConfig.ParseAddress` accepts it as a bare host or a URL.
DOMAIN=clinics.example.tn
# Email Let's Encrypt uses for expiry notices / account recovery.
ACME_EMAIL=admin@example.tn

# ── PostgreSQL — non-default credentials ─────────────────────────────────────
POSTGRES_DB=clinic_management
POSTGRES_USER=clinic_user
# Strong, unique. NEVER `clinic_password`.  e.g. `openssl rand -base64 24`
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── MinIO — non-default credentials ──────────────────────────────────────────
# NEVER `minioadmin`.  Access key >= 3 chars, secret >= 8 chars.
MINIO_ROOT_USER=CHANGE_ME_minio_access_key
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_secret

# ── Google Calendar OAuth (optional) ─────────────────────────────────────────
# The APPLICATION's OAuth client, shared by every clinic. Each clinic then connects its OWN calendar
# from the settings screen and its refresh token is stored per-clinic in the database — there is no
# shared refresh token here, deliberately. Leave both empty to ship without calendar sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── HuggingFace (AI chat, optional) ──────────────────────────────────────────
# One key for every clinic. ⚠️ Owed decision #4 (see plan.md): there is no per-clinic consent and no
# audit of what is sent. Leave empty to ship without the AI assistant.
HUGGINGFACE_API_KEY=

# ── Off-server backup ────────────────────────────────────────────────────────
# rclone remote + path for the nightly upload, e.g. `offsite:clinic-backups`. Configure the `offsite`
# remote in ./rclone/rclone.conf (gitignored). Empty keeps backups on-server only — NOT recommended,
# and in this topology it is every clinic's data, not one clinic's.
BACKUP_REMOTE=offsite:clinic-backups
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=14

# ── PITR: continuous WAL archiving + physical base backups (WAL-G → off-site S3) ──
# Restore to any second rather than to the last nightly dump. WAL and base backups MUST share one
# prefix so WAL-G can correlate the chain. The bucket must be DISTINCT from the on-VPS MinIO and
# from BACKUP_REMOTE above — it has to survive total server loss.
WALG_S3_PREFIX=s3://clinic-pitr-bucket/hosted
# Endpoint of the S3-compatible provider. Leave EMPTY for real AWS S3.
WALG_S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
WALG_S3_REGION=us-east-1
WALG_S3_ACCESS_KEY=CHANGE_ME_offsite_s3_access_key
WALG_S3_SECRET_KEY=CHANGE_ME_offsite_s3_secret_key
# Path-style addressing: `true` for most S3-compatible providers; `false` for real AWS S3.
WALG_S3_FORCE_PATH_STYLE=true
PITR_ARCHIVE_TIMEOUT=300
PITR_BASE_BACKUP_CRON=0 1 * * *
PITR_RETAIN_BASE_BACKUPS=7

# ── Authentication ────────────────────────────────────────────────────────────────────────
# Signs and validates every bearer token and every 12-hour refresh cookie. REQUIRED: absent, the
# API generates one onto the container's ephemeral layer, so every rebuild signs the whole fleet
# out mid-shift, and a second `api` replica rejects the first one's tokens outright.
#   openssl rand -base64 48
AUTH_LOCAL_SIGNING_KEY=CHANGE_ME_base64_at_least_32_bytes

# ── Network ───────────────────────────────────────────────────────────────────────────────
# The internal bridge subnet, pinned so `Security__TrustedProxies` can name it. Caddy and the web
# container reach the API from inside this range, and the API believes X-Forwarded-For only from a
# trusted peer — without it every rate-limit partition and the per-source login lockout collapse
# into one bucket for the entire service. Change both together or neither.
INTERNAL_SUBNET=172.20.0.0/16

# ⚠️ The Data Protection key ring lives in the `dataprotection_keys` named volume, not in this file
#    and not in the database. Everything encrypted at rest is unreadable without it, so it must be
#    backed up — but back it up SEPARATELY from postgres_data, never into the same archive. The ring
#    is stored in cleartext, so one archive holding both the ciphertext and its key means the
#    encryption protects nothing against a leaked or stolen backup: whoever has it can forge auth
#    cookies and impersonate any clinic's e-invoicing identity.

# ── Vendor console (platform-console) ──────────────────────────────────────────────────────
# The private back-office where the vendor sees each cabinet's usage and records its payments. It
# exists ONLY on this profile, and it is OFF until CONSOLE_PORT is set: absent or 0 means absent —
# no second listener, no reachable route, 404 on every /api/platform path — never present-and-refusing.
#
# ⚠️ Reached over an SSH tunnel and nothing else. docker-compose publishes Caddy's console site on
#    127.0.0.1:9443 only, so from your workstation:
#      ssh -L 9443:127.0.0.1:9443 <host>   then open  https://127.0.0.1:9443
#    Expect a certificate warning: that site uses Caddy's internal CA, because a loopback address
#    has no public name for Let's Encrypt to issue against.
CONSOLE_PORT=5443

# ⚠️ MUST NOT be AUTH_LOCAL_SIGNING_KEY. The two token populations are kept apart by having different
#    signing keys, issuers and audiences — that is what makes a clinic token presented to the console
#    (and a console token presented to a clinic route) fail *validation* rather than merely fail a
#    policy check. Reusing the clinic key would quietly turn that guarantee into an authorization
#    decision one forgotten attribute away from working.
#    Startup FAILS LOUD if this is empty while CONSOLE_PORT > 0.
#   openssl rand -base64 48
CONSOLE_SIGNING_KEY=CHANGE_ME_base64_at_least_32_bytes

# Console accounts are created by a command, never a web page (there is no sign-up screen and no
# user-management screen in the console at all):
#   docker exec clinic-api-prod dotnet ClinicManagement.API.dll platform-account create \
#     --email ops@editeur.tn --name "Nom Prénom"
# It prints a one-time password and an enrolment secret, each shown ONCE. Store the secret in an
# authenticator app, then enrol from the console's sign-in screen — that step returns the recovery
# codes, also shown once.

# ── Abonnements (clinic-subscription) ─────────────────────────────────────────────────────
# HostedMultiTenant is the ONLY deployment kind that enforces a subscription, and « Abonnement »
# is the screen a refused save points a chairside user at. Leave these blank and that screen says
# « Aucun tarif n'est publié », « Les modalités de paiement ne sont pas publiées… » and « Aucune
# coordonnée n'est publiée » — to a practice that has just gone read-only and is trying to pay you.
#
# ⚠️ There is deliberately no `SUBSCRIPTION_ENABLED`: enforcement follows Deployment__Profile and
#    nothing an operator can set. A blank price reads as « sur devis », never as « 0,000 DT ».
# ⚠️ Prices are parsed with the invariant culture — write 120.500, never 120,500.
SUBSCRIPTION_TRIAL_DAYS=30
SUBSCRIPTION_CABINET_MONTHLY_DT=
SUBSCRIPTION_CABINET_ANNUAL_DT=
SUBSCRIPTION_CLINIQUE_MONTHLY_DT=
SUBSCRIPTION_CLINIQUE_ANNUAL_DT=
SUBSCRIPTION_SURMESURE_MONTHLY_DT=
SUBSCRIPTION_SURMESURE_ANNUAL_DT=
# Several lines of bank details. Line breaks are preserved on screen, so write it as you want it read.
SUBSCRIPTION_PAYMENT_INSTRUCTIONS=
SUBSCRIPTION_CONTACT_EMAIL=
SUBSCRIPTION_CONTACT_PHONE=

# ── Meta / WhatsApp ───────────────────────────────────────────────────────────────────────
# The Graph API version, read by BOTH the api service (`Meta__GraphApiVersion`, the server's own
# Graph calls) and the web image's build arg (`NEXT_PUBLIC_META_GRAPH_VERSION`, the browser JS
# SDK's `FB.init({ version })`).
#
# ⚠️ One key on purpose. The two were pinned independently — a server default and a hard-coded
#    browser constant — so raising one moved the server's calls and left the SDK a version behind.
# ⚠️ The web side is baked at BUILD time (`NEXT_PUBLIC_*` is substituted into the bundle), so
#    changing this needs `docker compose up -d --build`, not a restart.
META_GRAPH_API_VERSION=v21.0

# The platform Meta app behind « Connecter WhatsApp » (US-1). Leave these empty and the button is **absent** —
# the forfait section, its figures and the vendor console all keep working, because an allowance a cabinet
# cannot yet spend is still a real allowance.
#
# ⚠️ `META_APP_ID` and `META_CONFIG_ID` are PUBLIC (they reach the browser bundle) and are baked at BUILD time,
#    so changing either needs `docker compose up -d --build`. `META_APP_SECRET` is a secret: it never reaches the
#    browser, and it is what signs every webhook payload.
META_APP_ID=
META_CONFIG_ID=
META_APP_SECRET=

# A token of your own choosing, typed into Meta's webhook dashboard and echoed back once during the
# subscription handshake. ⚠️ Empty ⇒ the handshake REFUSES, so the subscription cannot be registered at all —
# which is deliberate: the alternative is an endpoint anybody can subscribe. Generate something random,
# e.g. `openssl rand -hex 24`.
META_WEBHOOK_VERIFY_TOKEN=
