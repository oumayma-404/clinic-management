# Copy to `.env` (same folder) and fill in real values. `.env` is gitignored — never commit it.
# docker-compose reads this file automatically. See ../DEPLOY.md for the full runbook.
#
# ⚠️  ROTATE every value that was ever committed to git history before going live
#     (Google client-secret + refresh token, HuggingFace key, Auth0 secrets, DB password).

# ── Domain & TLS ─────────────────────────────────────────────────────────────
# The public domain whose A record points at this VPS. Caddy obtains a Let's Encrypt
# cert for it; ports 80/443 must be open and the DNS live before first boot (AC-2).
DOMAIN=clinic.example.com
# Email Let's Encrypt uses for expiry notices / account recovery.
ACME_EMAIL=admin@example.com

# ── PostgreSQL — non-default credentials (AC-5) ──────────────────────────────
POSTGRES_DB=clinic_management
POSTGRES_USER=clinic_user
# Strong, unique. NEVER `clinic_password`.  e.g. `openssl rand -base64 24`
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# ── MinIO — non-default credentials (AC-5) ───────────────────────────────────
# NEVER `minioadmin`.  Access key >= 3 chars, secret >= 8 chars.
MINIO_ROOT_USER=CHANGE_ME_minio_access_key
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_secret

# ── Auth0 — web app (Regular Web Application) ────────────────────────────────
# Bare tenant domain, no scheme (e.g. dev-xxxxx.eu.auth0.com). Used by both api and web.
AUTH0_DOMAIN=your-tenant.eu.auth0.com
# API identifier configured in Auth0 (also the token audience).
AUTH0_AUDIENCE=https://clinic-management-api
AUTH0_CLIENT_ID=your_web_app_client_id
AUTH0_CLIENT_SECRET=your_web_app_client_secret
# Session encryption secret for the Next Auth0 SDK.  `openssl rand -hex 32`
AUTH0_SECRET=CHANGE_ME_64_char_hex_session_secret

# ── Auth0 — Management API (Machine-to-Machine app) ──────────────────────────
AUTH0_MGMT_CLIENT_ID=your_m2m_client_id
AUTH0_MGMT_CLIENT_SECRET=your_m2m_client_secret

# ── Google Calendar OAuth — ROTATE before deploy ─────────────────────────────
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE_ME_rotated_google_client_secret
GOOGLE_REFRESH_TOKEN=CHANGE_ME_rotated_google_refresh_token
GOOGLE_CALENDAR_ID=primary

# ── HuggingFace (AI chat) — ROTATE before deploy ─────────────────────────────
HUGGINGFACE_API_KEY=CHANGE_ME_rotated_huggingface_key

# ── Off-server backup ────────────────────────────────────────────────────────
# rclone remote + path for the nightly upload, e.g. `offsite:clinic-backups`.
# Configure the `offsite` remote in ./rclone/rclone.conf (gitignored). Leave BACKUP_REMOTE
# empty to keep backups on-server only (NOT recommended — defeats off-server durability).
BACKUP_REMOTE=offsite:clinic-backups
# Cron schedule for the nightly run (default: 02:00 daily). Standard 5-field cron.
BACKUP_CRON=0 2 * * *
# Days to keep local staged copies before pruning.
BACKUP_RETENTION_DAYS=14

# ── PITR: continuous WAL archiving + physical base backups (WAL-G → off-site S3) ──
# Point-in-Time Recovery — restore the DB to any second, not just the last nightly dump.
# See ../DEPLOY.md "Point-in-Time Recovery (PITR)". These drive BOTH Postgres's archive_command
# (`wal-g wal-push`) and the pitr sidecar (`wal-g backup-push`); WAL and base backups MUST share
# one prefix so WAL-G can correlate the chain (AC-3). Every value here is a secret/config — this
# file is gitignored (.env), .env.example carries only placeholders.
#
# Dedicated off-site S3-compatible bucket, DISTINCT from the on-VPS MinIO and the pg_dump
# BACKUP_REMOTE above (must survive total server loss). Form: s3://<bucket>[/<path>].
WALG_S3_PREFIX=s3://clinic-pitr-bucket/prod
# Endpoint of the S3-compatible provider (Backblaze B2 / Wasabi / off-VPS MinIO / …).
# Leave EMPTY for real AWS S3 (WAL-G uses the AWS default for the region).
WALG_S3_ENDPOINT=https://s3.us-west-002.backblazeb2.com
WALG_S3_REGION=us-east-1
WALG_S3_ACCESS_KEY=CHANGE_ME_offsite_s3_access_key
WALG_S3_SECRET_KEY=CHANGE_ME_offsite_s3_secret_key
# Path-style addressing: `true` for most S3-compatible providers; set `false` for real AWS S3.
WALG_S3_FORCE_PATH_STYLE=true
# Force a WAL switch at least this often (seconds) so a low-write clinic still ships recent
# changes promptly (bounds worst-case loss). Each switch uploads one 16 MB segment.
PITR_ARCHIVE_TIMEOUT=300
# Schedule for the physical base backup (standard 5-field cron; default 01:00 daily).
PITR_BASE_BACKUP_CRON=0 1 * * *
# Keep this many most-recent base backups; older bases + the WAL they no longer anchor are pruned (AC-7).
PITR_RETAIN_BASE_BACKUPS=7
